{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dsr:memoria:atualizacao:v1",
  "title": "Memória condicional de atualização monetária Dissero v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "engine_version", "principal", "currency",
    "data_base", "calculation_date", "regime", "rounding", "segments",
    "factor_total", "conditional_updated_value", "conditional_difference", "warnings"
  ],
  "properties": {
    "schema_version": { "const": "dsr.memoria_atualizacao.v1" },
    "status": { "const": "MINUTA_PARA_REVISAO" },
    "engine_version": { "type": "string", "minLength": 1 },
    "principal": { "type": "string" },
    "currency": { "const": "BRL" },
    "data_base": { "type": "string" },
    "calculation_date": { "type": "string" },
    "regime": { "type": "object" },
    "rounding": { "type": "object" },
    "segments": { "type": "array", "minItems": 1 },
    "factor_total": { "type": "string" },
    "conditional_updated_value": { "type": "string" },
    "conditional_difference": { "type": "string" },
    "warnings": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
